{
  "name": "inkpress",
  "version": "0.2.0",
  "private": true,
  "description": "墨压 · AI 小说写作台",
  "homepage": "https://github.com/inkpress/studio",
  "author": {
    "name": "InkPress",
    "email": "inkpress@example.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --port 43123 --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-standalone.cjs",
    "start": "next start --port 43123 --hostname 127.0.0.1",
    "lint": "eslint",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.inkpress.studio",
    "productName": "墨压",
    "copyright": "Copyright © InkPress",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!**/*.{md,map}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md}"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "AI 小说写作台",
      "maintainer": "InkPress <inkpress@example.com>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "墨压"
    }
  }
}
